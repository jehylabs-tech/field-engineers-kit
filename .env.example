# Supabase project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous/public key (Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: override the allowed admin email (defaults to jehylabs@gmail.com)
ADMIN_ALLOWED_EMAIL=jehylabs@gmail.com

# Public site URL for SEO canonical, sitemap, and Open Graph.
# Required on Vercel (never use localhost in a deployed environment).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console site verification (meta tag content value)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-site-verification-code

# Google Analytics 4 measurement ID (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Vercel Analytics — enabled by default on Vercel; set to "false" to disable locally
NEXT_PUBLIC_VERCEL_ANALYTICS=true
